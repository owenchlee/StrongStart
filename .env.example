# Copy to .env (npm start / npm run dev read it automatically). Everything is optional:
# with no settings at all the app runs locally on an in-memory database with email logged only.
PORT=3000
BASE_URL=http://localhost:3000        # public URL used in emailed links and QR codes

# Database: leave empty to use the built-in in-memory PGlite (data resets on restart).
TIGER_DATABASE_URL=                   # Tiger Data / Postgres URL, e.g. postgres://user:pass@host:5432/db?sslmode=require
# PGLITE_DIR=data/pglite              # optional: persist the local PGlite database in this folder

# AI (Gemini): handwriting reading, translation, report summaries, voice structuring
GEMINI_API_KEY=                       # from Google AI Studio
GEMINI_MODEL=                         # optional, default gemini-3.8-flash

# ElevenLabs: read-aloud, voice feedback and email dictation
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                  # optional voice for read-aloud

# Cloudinary: stores uploaded form photos
CLOUDINARY_URL=                       # cloudinary://<api_key>:<api_secret>@<cloud_name>

# Inbound email webhook: shared secret the email provider must send
INBOUND_EMAIL_SECRET=
ENABLE_JOBS=                          # set to 1 to run background jobs (e.g. shipped-order reminders)
TRUST_PROXY=                          # behind a reverse proxy (Vultr/Caddy)? hop count, e.g. 1; auto-1 when BASE_URL is https

# Staff login. Create an OAuth client at console.cloud.google.com > APIs & Services > Credentials
# (type "Web application"), with redirect URI: BASE_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_ADMIN_EMAILS=                   # comma-separated; added to the staff table as admins on startup
REQUIRE_AUTH=                         # staff login is OFF by default for now; set to 1 to require it (do this before any public deploy)
AUTH_DEV_LOGIN=                       # set to 1 for local email-only login (NEVER in production)

# Outgoing email (leave SMTP_HOST empty to only log emails to the dashboard's Emails tab)
STAFF_EMAIL=babyconnections@strongstart.example
MAIL_FROM="Baby Connections <babyconnections@strongstart.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Training scheduling ("Start training" on a partner): uses the same Google OAuth client as staff login.
# In Google Cloud: enable the Google Calendar API and add this redirect URI to the OAuth client:
#   BASE_URL + /api/google/calendar/callback
# Each staff member then clicks "Connect Google Calendar" under Profile > My availability & calendar.
